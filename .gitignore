# OS and editor files
.DS_Store
.idea/
.vscode/
.cursor/
.claude/
.history/
*.iml
*.swp
*.swo

# Python bytecode, caches, and build output
__pycache__/
*.py[cod]
*$py.class
*.so
.cache/
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
.eggs/
wheels/
*.egg
__pypackages__/

# Local Python environments and environment variables
.env
.env.*
!.env.example
.envrc
.venv/
.venv-*/
venv/
env/

# Local server configuration, firmware, logs, and generated audio
/main/xiaozhi-server/data/
/main/xiaozhi-server/tmp/
*.log
*.pid

# Local ASR recordings and generated wake-word assets
/main/xiaozhi-server/config/assets/wakeup_words/
/main/xiaozhi-server/config/assets/*.wav
/main/xiaozhi-server/config/assets/*.mp3
/main/xiaozhi-server/config/assets/*.m4a
/main/xiaozhi-server/config/assets/*.flac
/main/xiaozhi-server/config/assets/*.opus

# Additional local model downloads. Keep the bundled defaults versioned.
/main/xiaozhi-server/models/asr/sherpa/*/
/main/xiaozhi-server/models/tts/sherpa/*/
/main/xiaozhi-server/models/vad/*
